---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Pillars from '../components/home/Pillars.astro';
import Goals from '../components/home/Goals.astro';
import SubmissionBanner from '../components/home/SubmissionBanner.astro';
import CreativeHub from '../components/home/CreativeHub.astro';
import Voices from '../components/home/Voices.astro';
import VenueGuide from '../components/home/VenueGuide.astro';
import Partners from '../components/home/Partners.astro';
import { FESTIVAL_INFO } from '../data/festival';
---

<BaseLayout
  title={`${FESTIVAL_INFO.name} | ${FESTIVAL_INFO.tagline}`}
  description="MUSANABANDI is Rwanda's disability-inclusive film festival championing dignity, creative equality, and barrier-free cinema narratives in Kigali."
>
  <Hero />
  <Pillars />
  <Goals />
  <SubmissionBanner />
  <CreativeHub />
  <Voices />
  <VenueGuide />
  <Partners />
</BaseLayout>
