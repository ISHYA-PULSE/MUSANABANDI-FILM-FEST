---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Opportunities from '../components/home/Opportunities.astro';
import Spirit from '../components/home/Spirit.astro';
import VoicesAndPartners from '../components/home/VoicesAndPartners.astro';
import { FESTIVAL_INFO } from '../data/festival';
---

<BaseLayout
  title={`${FESTIVAL_INFO.name} | ${FESTIVAL_INFO.tagline}`}
  description="MUSANABANDI is Rwanda's disability-inclusive film festival championing dignity, creative equality, and barrier-free cinema narratives in Kigali."
>
  <Hero />
  <Opportunities />
  <Spirit />
  <VoicesAndPartners />
</BaseLayout>
