---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FESTIVAL_INFO } from '../data/festival';
import { FESTIVAL_DAYS, PROGRAM_EVENTS } from '../data/program';
---

<BaseLayout
  title={`Festival Program & Schedule | ${FESTIVAL_INFO.name}`}
  description="Explore the complete screening schedule, masterclasses, and panels for MUSANABANDI Film Festival in Kigali."
>
  <div class="py-16 md:py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent-amber)] mb-2 block">
        Festival Lineup • {FESTIVAL_INFO.dates}
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-[var(--color-text-primary)]">
        Official Festival Program
      </h1>
      <p class="mt-4 text-base text-[var(--color-text-secondary)]">
        All screenings, workshops, and panels are barrier-free with live captioning, Rwandan Sign Language, and audio descriptions.
      </p>
    </header>

    <!-- Days Filter Bar -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
      {FESTIVAL_DAYS.map((day, idx) => (
        <div class="px-5 py-3 rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] text-center">
          <span class="block text-xs font-bold uppercase text-[var(--color-accent-amber)]">{day.label}</span>
          <span class="text-xs text-[var(--color-text-secondary)]">{day.theme}</span>
        </div>
      ))}
    </div>

    <!-- Events List -->
    <div class="space-y-6">
      {PROGRAM_EVENTS.map(event => (
        <article class="p-6 md:p-8 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-accent-amber)] transition-all">
          <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-4">
            <div>
              <div class="flex items-center gap-3 mb-2">
                <span class="px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wider bg-[var(--color-accent-amber)] text-black">
                  {event.category}
                </span>
                <span class="text-xs font-mono text-[var(--color-text-muted)]">
                  {event.time}
                </span>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-[var(--color-text-primary)]">
                {event.title}
              </h2>
              {event.speakerOrDirector && (
                <p class="text-xs font-medium text-[var(--color-accent-indigo)] mt-1">
                  {event.speakerOrDirector}
                </p>
              )}
            </div>
            <div class="text-left md:text-right">
              <span class="text-xs text-[var(--color-text-muted)] block">Venue</span>
              <span class="text-xs font-semibold text-[var(--color-text-primary)]">{event.venue}</span>
            </div>
          </div>

          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-6">
            {event.description}
          </p>

          <!-- Accessibility Badges -->
          <div class="flex flex-wrap items-center gap-2 pt-4 border-t border-[var(--color-border-subtle)]">
            <span class="text-[11px] font-semibold uppercase text-[var(--color-text-muted)] mr-2">Accessibility:</span>
            {event.accessibilityBadges.map(badge => (
              <span class="px-2 py-1 rounded-md text-xs font-medium bg-[var(--color-canvas)] border border-[var(--color-border)] text-[var(--color-text-secondary)]">
                {badge}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
