---
import { SUBMISSION_DEADLINES } from '../../data/submissions';
---
<section class="relative overflow-hidden py-20 bg-[var(--color-surface)] border-b border-[var(--color-border-subtle)]">
  <!-- Atmospheric Screening Hall Backdrop with 90% Dark Scrim -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/crowd-celebration.jpg"
      alt=""
      role="presentation"
      class="w-full h-full object-cover opacity-10 filter blur-[1px]"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-surface)] via-[var(--color-surface)]/95 to-[var(--color-surface)]/85"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Info -->
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-[var(--color-accent-amber)] text-black">
          <span>🌟</span> 3 Open Calls for MUSANABANDI 2026
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text-primary)]">
          Submit Film, Exhibit Art, or Join the Workshop
        </h2>
        <p class="text-base text-[var(--color-text-secondary)] leading-relaxed">
          MUSANABANDI invites creators, visual artists, and youth with disabilities to participate in the December 2026 edition in Kigali.
        </p>

        <!-- 3 Quick Pathway Pills -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
          <div class="p-3 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-border)]">
            <span class="text-base block mb-1">🎬</span>
            <strong class="text-xs text-[var(--color-text-primary)] block">1. Film Submission</strong>
            <span class="text-[11px] text-[var(--color-text-muted)]">Short, Feature & Doc</span>
          </div>
          <div class="p-3 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-border)]">
            <span class="text-base block mb-1">🎨</span>
            <strong class="text-xs text-[var(--color-text-primary)] block">2. Exhibition</strong>
            <span class="text-[11px] text-[var(--color-text-muted)]">Art & Cultural Stalls</span>
          </div>
          <div class="p-3 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-border)]">
            <span class="text-base block mb-1">📷</span>
            <strong class="text-xs text-[var(--color-text-primary)] block">3. Photography</strong>
            <span class="text-[11px] text-[var(--color-text-muted)]">Youth Masterclass</span>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-[var(--color-canvas)]/90 border border-[var(--color-accent-amber)]/30 text-sm text-[var(--color-text-secondary)]">
          <strong class="text-[var(--color-accent-amber)]">Accessibility & Equity:</strong> Application fees are 100% waived for creators, artists, and youth with disabilities.
        </div>

        <div class="pt-2 flex flex-wrap gap-4">
          <a
            href="/submit"
            class="px-6 py-3 rounded-xl font-extrabold bg-[var(--color-accent-amber)] hover:bg-[var(--color-accent-amber-hover)] text-black transition-all shadow-md"
          >
            Explore Calls & Apply
          </a>
          <a
            href="/submit#categories"
            class="px-6 py-3 rounded-xl font-semibold bg-[var(--color-canvas)] hover:bg-[var(--color-surface)] border border-[var(--color-border)] text-white transition-all"
          >
            Film Categories
          </a>
        </div>
      </div>

      <!-- Right Timeline Card -->
      <div class="lg:col-span-5 bg-[var(--color-canvas)]/90 backdrop-blur-sm p-6 rounded-2xl border border-[var(--color-border)]">
        <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-primary)] mb-4 pb-2 border-b border-[var(--color-border)]">
          Key Submission Deadlines
        </h3>
        <div class="space-y-4">
          {SUBMISSION_DEADLINES.map(deadline => (
            <div class="flex items-center justify-between text-sm py-1 border-b border-[var(--color-border-subtle)] last:border-0">
              <div>
                <span class="font-semibold block text-[var(--color-text-primary)]">{deadline.stage}</span>
                <span class="text-xs text-[var(--color-accent-amber)]">{deadline.fee}</span>
              </div>
              <span class="text-xs font-mono text-[var(--color-text-secondary)]">{deadline.date}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
