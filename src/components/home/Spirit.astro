---
import { FESTIVAL_INFO, PILLARS } from '../../data/festival';
---

<section class="py-16 sm:py-20 bg-[var(--color-canvas)] border-b border-[var(--color-border-subtle)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Photo -->
      <div class="lg:col-span-5 relative">
        <div class="rounded-3xl overflow-hidden border border-[var(--color-border)] shadow-xl">
          <img
            src="/images/about-joyful-audience.jpg"
            alt="Joyful Rwandan creators and youth advocates smiling together at an inclusive arts event"
            width="600"
            height="500"
            loading="lazy"
            decoding="async"
            class="w-full h-72 sm:h-80 md:h-96 object-cover object-center"
          />
        </div>
        <div class="absolute -bottom-4 -right-4 hidden sm:block p-4 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] shadow-lg max-w-[200px]">
          <span class="text-[10px] font-bold text-[var(--color-accent-indigo)] uppercase block">Shared Humanity</span>
          <p class="text-xs font-semibold text-[var(--color-text-primary)] mt-0.5">Inkuru Zidafite Imipaka</p>
        </div>
      </div>

      <!-- Right Mission Content -->
      <div class="lg:col-span-7 space-y-5 sm:space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent-amber)] block mb-2">
            About The Festival
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-[var(--color-text-primary)] leading-tight">
            Dignity, Inclusion, and Equal Creative Agency
          </h2>
        </div>

        <p class="text-xs sm:text-base text-[var(--color-text-secondary)] leading-relaxed">
          In Kinyarwanda, <strong class="text-[var(--color-text-primary)]">Musanabandi</strong> speaks to shared humanity, kinship, and fundamental equality. We believe that disability should never be a barrier to creative expression, participation, or leadership in society.
        </p>

        <!-- 4 Pillars Compact Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 pt-2">
          {PILLARS.map(p => (
            <div class="p-3 sm:p-3.5 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-border)] text-center">
              <strong class="text-xs font-bold text-[var(--color-accent-amber)] block">{p.title}</strong>
              <span class="text-[10px] text-[var(--color-text-muted)] block mt-0.5">{p.kinyarwanda}</span>
            </div>
          ))}
        </div>

        <div class="pt-3 sm:pt-4">
          <a
            href="/about"
            class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-[var(--color-accent-amber)] hover:text-white transition-colors"
          >
            <span>Read Our Origin Story & 8 Guiding Goals</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
