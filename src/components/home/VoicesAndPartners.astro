---
import { PARTNER_LOGOS } from '../../data/partners';
import { FESTIVAL_INFO } from '../../data/festival';
---

<section class="py-20 bg-[var(--color-surface)] border-b border-[var(--color-border-subtle)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Featured Community Voice Spotlight -->
    <div class="max-w-4xl mx-auto mb-16 p-8 sm:p-10 rounded-3xl bg-[var(--color-canvas)] border border-[var(--color-border)] relative">
      <span class="text-4xl text-[var(--color-accent-amber)] font-serif absolute top-6 left-6 opacity-30 select-none">“</span>
      <div class="relative z-10 space-y-6">
        <blockquote class="text-base sm:text-lg text-[var(--color-text-primary)] leading-relaxed italic pl-6">
          Directing with an adaptive camera rig in Kigali was pure joy. MUSANABANDI showed me and my peers that our stories are powerful, vibrant, and deserve the biggest cinema screen.
        </blockquote>
        <div class="flex items-center gap-4 pl-6 pt-4 border-t border-[var(--color-border-subtle)]">
          <img
            src="/images/voices-speaker-dignity.jpg"
            alt="Aimé Mugisha, Rwandan storyteller and advocate"
            width="56"
            height="56"
            loading="lazy"
            decoding="async"
            class="w-14 h-14 rounded-full object-cover border-2 border-[var(--color-accent-amber)] shrink-0"
          />
          <div>
            <cite class="not-italic font-bold text-sm text-[var(--color-text-primary)] block">Aimé Mugisha</cite>
            <span class="text-xs text-[var(--color-accent-amber)] block">Youth Director & Adaptive Storyteller</span>
            <span class="text-[11px] text-[var(--color-text-muted)] block">Kigali Inclusive Cinema Lab</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Partners Row -->
    <div class="text-center max-w-4xl mx-auto pt-4">
      <span class="text-xs font-bold uppercase tracking-widest text-[var(--color-text-muted)] block mb-6">
        Supported By & Cultural Collaborators
      </span>
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 opacity-80 hover:opacity-100 transition-opacity">
        {PARTNER_LOGOS.map(partner => (
          <div class="px-4 py-2 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-border-subtle)] flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-accent-indigo)]"></span>
            <span class="text-xs font-semibold text-[var(--color-text-secondary)]">{partner.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
