---
import { FESTIVAL_INFO } from '../data/festival';
import { NAV_LINKS, SOCIAL_LINKS } from '../data/navigation';
---
<footer class="bg-[var(--color-surface)] border-t border-[var(--color-border)] pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-[var(--color-border)]">
      <!-- Brand & Mission -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-[var(--color-accent-amber)] flex items-center justify-center font-bold text-black text-lg">M</div>
          <span class="text-xl font-bold tracking-tight text-[var(--color-text-primary)]">MUSANABANDI</span>
        </div>
        <p class="text-sm text-[var(--color-text-secondary)] max-w-md leading-relaxed">
          Rwanda's disability-inclusive film and creative arts festival. Promoting dignity, inclusion, equality, and equal opportunities through the transformative power of cinema.
        </p>
        <p class="text-xs font-semibold text-[var(--color-accent-amber)] tracking-wider uppercase">
          Stories Without Barriers • Inkuru Zidafite Imipaka
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[var(--color-text-primary)] mb-4">Festival</h3>
        <ul class="space-y-2.5 text-sm">
          {NAV_LINKS.map(link => (
            <li>
              <a href={link.href} class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent-amber)] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Inclusive Contact & Assistance -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[var(--color-text-primary)] mb-4">Inclusion & Contact</h3>
        <p class="text-xs text-[var(--color-text-secondary)] mb-3">
          For accessibility assistance, accommodation requests, or Rwandan Sign Language inquiries:
        </p>
        <div class="space-y-2">
          <a
            href={FESTIVAL_INFO.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white transition-colors"
          >
            <span>💬</span> WhatsApp Assistance
          </a>
          <div>
            <a href={`mailto:${FESTIVAL_INFO.email}`} class="text-xs text-[var(--color-text-secondary)] hover:text-white block mt-2">
              {FESTIVAL_INFO.email}
            </a>
          </div>
          <p class="text-xs text-[var(--color-text-muted)] mt-1">Kigali, Rwanda</p>
        </div>
      </div>
    </div>

    <!-- Bottom Legal & Accessibility Statement -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--color-text-muted)]">
      <p>© {new Date().getFullYear()} {FESTIVAL_INFO.name}. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/accessibility" class="hover:text-[var(--color-accent-amber)] transition-colors">Accessibility Policy (WCAG AAA)</a>
        <span>•</span>
        <span>Film • Inclusion • Dignity • Ability</span>
      </div>
    </div>
  </div>
</footer>
