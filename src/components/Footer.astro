---
import { FESTIVAL_INFO } from '../data/festival';
import { NAV_LINKS, SOCIAL_LINKS } from '../data/navigation';
---
<footer class="bg-[var(--color-surface)] border-t border-[var(--color-border)] pt-12 sm:pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 pb-10 sm:pb-12 border-b border-[var(--color-border)]">
      <!-- Brand & Mission -->
      <div class="sm:col-span-2 lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/images/brand/logo-gold-charcoal.jpg"
            alt="MUSANABANDI Logo"
            width="40"
            height="40"
            class="w-10 h-10 rounded-xl object-contain border border-[var(--color-border)] shadow-md"
          />
          <span class="text-xl font-bold tracking-tight text-[var(--color-text-primary)]">MUSANABANDI</span>
        </div>
        <p class="text-xs sm:text-sm text-[var(--color-text-secondary)] max-w-md leading-relaxed">
          Rwanda's disability-inclusive film and creative arts festival. Promoting dignity, inclusion, equality, and equal opportunities through the transformative power of cinema.
        </p>
        <p class="text-xs font-semibold text-[var(--color-accent-amber)] tracking-wider uppercase">
          Stories Without Barriers • Inkuru Zidafite Imipaka
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-[var(--color-text-primary)] mb-3 sm:mb-4">Festival</h3>
        <ul class="space-y-2 text-xs sm:text-sm">
          {NAV_LINKS.map(link => (
            <li>
              <a href={link.href} class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent-amber)] transition-colors py-1 inline-block">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Inclusive Contact & Assistance -->
      <div>
        <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-[var(--color-text-primary)] mb-3 sm:mb-4">Inclusion & Contact</h3>
        <p class="text-xs text-[var(--color-text-secondary)] mb-3 leading-relaxed">
          For accessibility assistance, accommodation requests, or Rwandan Sign Language inquiries:
        </p>
        <div class="space-y-2">
          <a
            href={FESTIVAL_INFO.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs font-semibold px-3.5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white transition-colors shadow-sm"
          >
            <span>💬</span> WhatsApp Assistance
          </a>
          <div>
            <a href={`mailto:${FESTIVAL_INFO.email}`} class="text-xs text-[var(--color-text-secondary)] hover:text-white block mt-2 break-all">
              {FESTIVAL_INFO.email}
            </a>
          </div>
          <p class="text-xs text-[var(--color-text-muted)] mt-1">RP ICT Innovation Center • Kigali, Rwanda</p>
        </div>
      </div>
    </div>

    <!-- Bottom Legal & Accessibility Statement -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--color-text-muted)] text-center sm:text-left">
      <p>© {new Date().getFullYear()} {FESTIVAL_INFO.name}. All rights reserved.</p>
      <div class="flex flex-wrap items-center justify-center sm:justify-end gap-3 sm:gap-6">
        <span class="text-[var(--color-text-muted)]">100% Barrier-Free & WCAG AAA Compliant</span>
        <span class="hidden sm:inline">•</span>
        <span>Film • Inclusion • Dignity • Ability</span>
      </div>
    </div>
  </div>
</footer>
